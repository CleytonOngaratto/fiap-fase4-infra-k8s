# ============================================================================
# .gitignore — plataforma da Fase 4 (Terraform)
# Regra: comentário sempre em linha própria — no .gitignore, texto depois de um
# padrão faz parte do padrão.
# ============================================================================

# ---------------------------------------------------------------------------
# Terraform — state e artefatos (NUNCA versionar: contêm tudo em texto plano)
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
.terraform/
# Planos salvos carregam um retrato do state (IDs de conta, endpoints, certificado do cluster).
# "tfplan*" cobre também nomes como tfplan.repo2 — na Fase 3 dois desses chegaram a ser
# versionados por engano.
*.tfplan
tfplan*
crash.log
crash.*.log
# Config do backend: depende da conta do Learner Lab (gerada por scripts/bootstrap-backend.ps1).
backend.hcl
# Valores locais. O terraform.tfvars.example É versionado (não casa estes padrões) e serve de molde;
# no CI os mesmos valores chegam por TF_VAR_* a partir das repository variables.
terraform.tfvars
*.auto.tfvars
*.tfvars.json
# Overrides locais e config da CLI (pode conter token).
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# O .terraform.lock.hcl é versionado de propósito: o CI resolve os mesmos providers da máquina.

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
# Kubeconfig gerado por `aws eks update-kubeconfig --kubeconfig ./...`
kubeconfig
kubeconfig.*

# ---------------------------------------------------------------------------
# Segredos e credenciais — NUNCA versionar
# ---------------------------------------------------------------------------
.secrets/
.aws/
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# IDEs, sistema operacional e logs
# ---------------------------------------------------------------------------
.idea
*.iml
.vscode
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.log

# ---------------------------------------------------------------------------
# IA / cockpit (moram na pasta-mãe, não neste repo)
# ---------------------------------------------------------------------------
CLAUDE.md
.claude/
.handoff/
PLAN-FASE4.md
PROGRESS-FASE4.md
